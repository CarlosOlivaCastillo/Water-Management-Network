# Dockerfile para el Engine de Estación de Riego (WM_WS_E)
FROM eclipse-temurin:17-jdk-alpine AS builder

WORKDIR /app

# Copiar librerías y código fuente
COPY kafka-clients.jar slf4j-api.jar slf4j-simple.jar ./
COPY ProtocoloUtil.java WM_WS_E.java ./

# Compilar con el classpath de las librerías
RUN javac -cp ".:kafka-clients.jar:slf4j-api.jar:slf4j-simple.jar" ProtocoloUtil.java WM_WS_E.java

# Imagen final ligera JRE
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Copiar librerías y clases compiladas
COPY kafka-clients.jar slf4j-api.jar slf4j-simple.jar ./
COPY --from=builder /app/*.class ./

# Variables de entorno por defecto
ENV IP_KAFKA=broker \
    PUERTO_KAFKA=9092 \
    IP_MONITOR=monitor \
    PUERTO_MONITOR=5000 \
    ID_WS=WS_01

# Ejecutar con soporte interactivo (-i -t) si se quiere simular KO por teclado
ENTRYPOINT ["sh", "-c", "java -cp '.:kafka-clients.jar:slf4j-api.jar:slf4j-simple.jar' WM_WS_E ${IP_KAFKA} ${PUERTO_KAFKA} ${IP_MONITOR} ${PUERTO_MONITOR} ${ID_WS}"]
